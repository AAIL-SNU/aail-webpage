          <!-- Panel: Members (Students) -->
          <div class="about-panel" id="about-panel-members">
            <div id="students-container">
              {% set studentGroups = [
                { label: 'PhD Students',  members: members.snu.phd, avatarKey: 'phd', defaultRole: 'PhD Student'  },
                { label: 'MSc Students',  members: members.snu.msc, avatarKey: 'msc', defaultRole: 'MSc Student'  },
                { label: 'BSc Students',  members: members.snu.bsc, avatarKey: 'bsc', defaultRole: 'BSc Student'  }
              ] %}
              {% for group in studentGroups %}
              {% if group.members | length > 0 %}
              <div class="members-group fade-in">
                <h3 class="members-group-title">{{ group.label }}</h3>
                <div class="members-subgroup">
                  <div class="members-grid members-grid-cols3">
                    {% for mem in group.members %}
                    {{ macros.memberCard(mem, group.avatarKey, group.defaultRole) }}
                    {% endfor %}
                  </div>
                </div>
              </div>
              {% endif %}
              {% endfor %}
            </div>
          </div>

          <!-- Panel: Alumni -->
          <div class="about-panel" id="about-panel-alumni">
            <div id="alumni-container">
              {% set alumniMembers = members.cranfield.phd %}
              {% if alumniMembers | length > 0 %}
              <div class="members-group fade-in">
                <h3 class="members-group-title">PhD Alumni <span class="members-group-note">(Co-supervised, Cranfield University)</span></h3>
                <div class="members-subgroup">
                  <div class="members-grid members-grid-cols3">
                    {% for mem in alumniMembers %}
                    {{ macros.memberCard(mem, 'phd', 'PhD Alumni') }}
                    {% endfor %}
                  </div>
                </div>
              </div>
              {% else %}
              <p style="color:var(--text-lt);font-size:.9rem;padding:16px 0;">No alumni records yet.</p>
              {% endif %}
            </div>
          </div>

          <!-- Panel: Collaborators -->
          <div class="about-panel" id="about-panel-collaborators">
            <div class="collab-section fade-in">
              <ul class="collab-list" id="collab-grid">
                {% for c in collaborators %}
                  <li>
                    {% if c.url %}
                      <a href="{{ c.url }}" target="_blank" rel="noopener">{{ c.name }}</a>
                    {% else %}
                      <span>{{ c.name }}</span>
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
            </div>
          </div>

          <!-- Panel: Courses -->
          <div class="about-panel" id="about-panel-courses">

            <div class="course-uni fade-in">
              <div class="course-uni-header">
                <span class="course-uni-badge">SNU</span>
                <h3 class="course-uni-name">Seoul National University</h3>
              </div>
              <div class="course-grid">
                <div class="course-card">
                  <span class="course-level">Undergraduate</span>
                  <h4 class="course-name">Flight Dynamics and Control</h4>
                  <p class="course-code">M2795.004500</p>
                  <p class="course-period">Fall 2025</p>
                </div>
                <div class="course-card">
                  <span class="course-level">Graduate</span>
                  <h4 class="course-name">Theory of Flight Vehicle Guidance and Control</h4>
                  <p class="course-code">M2795.006900</p>
                  <p class="course-period">Spring 2026</p>
                </div>
              </div>
            </div>

            <div class="course-uni fade-in">
              <div class="course-uni-header">
                <span class="course-uni-badge">CU</span>
                <h3 class="course-uni-name">Cranfield University</h3>
              </div>

              <div class="course-program">
                <h4 class="course-program-title">MSc in Autonomous Vehicle Dynamics and Control</h4>
                <div class="course-grid">
                  <div class="course-card">
                    <h4 class="course-name">UAS Dynamics and Control</h4>
                    <p class="course-period">2024–2025</p>
                    <span class="course-role">Module Lecturer</span>
                  </div>
                  <div class="course-card">
                    <h4 class="course-name">Modelling and Simulation</h4>
                    <p class="course-period">2024–2025</p>
                    <span class="course-role">Module Instructor</span>
                  </div>
                  <div class="course-card">
                    <h4 class="course-name">Autonomous Vehicle Control Systems</h4>
                    <p class="course-period">2024–2025</p>
                    <span class="course-role">Module Lecturer</span>
                  </div>
                  <div class="course-card">
                    <h4 class="course-name">Sensor Fusion</h4>
                    <p class="course-period">2021–2022, 2022–2023</p>
                    <span class="course-role">Module Lecturer</span>
                  </div>
                  <div class="course-card">
                    <h4 class="course-name">Guidance and Navigation for Autonomous Systems</h4>
                    <p class="course-period">2022–2023, 2023–2024, 2024–2025</p>
                  </div>
                  <div class="course-card">
                    <h4 class="course-name">Group Design Project</h4>
                    <p class="course-period">2020–2021, 2021–2022, 2024–2025</p>
                    <span class="course-role">Team Supervisor</span>
                  </div>
                </div>
              </div>

              <div class="course-program">
                <h4 class="course-program-title">MSc in Sensors and Communication</h4>
                <div class="course-grid">
                  <div class="course-card">
                    <h4 class="course-name">Sensor Resource Management</h4>
                    <p class="course-period">2025</p>
                    <span class="course-role">Module Lecturer</span>
                  </div>
                </div>
              </div>

              <div class="course-program">
                <h4 class="course-program-title">Short Courses</h4>
                <div class="course-grid">
                  <div class="course-card">
                    <h4 class="course-name">Kalman Filtering, Sensor Fusion, and Target Tracking</h4>
                    <p class="course-period">October 2022</p>
                    <span class="course-role">ADD</span>
                  </div>
                  <div class="course-card">
                    <h4 class="course-name">Optimal Control, Guidance for Autonomous Systems</h4>
                    <p class="course-period">April 2023</p>
                    <span class="course-role">ADD</span>
                  </div>
                </div>
              </div>
            </div>

          </div><!-- /about-panel-courses -->

          <!-- Panel: Legacy of FDCL -->
          <div class="about-panel" id="about-panel-legacy">
            <div class="legacy-section fade-in">
              <p class="legacy-desc">The Aerospace Autonomy and Intelligence Laboratory (AAIL) represents the third generation at Seoul National University, continuing the Flight Dynamics and Control Laboratory's (FDCL) academic tradition spanning seven decades. The laboratory combines the precision of traditional control engineering with the transformative power of modern computing.</p>
              <p class="legacy-desc legacy-desc-kr">항공우주 자율지능 연구실(AAIL)은 서울대학교에서 이어져 온 탁월한 학문적 계보의 3세대 연구실입니다. AAIL은 지난 70년간 대한민국 항공우주 제어 연구의 흐름을 이끌어 온 지적 산실인 비행역학 및 제어 연구실(FDCL)의 학문적 전통을 자랑스럽게 계승하고 있습니다. 선대 연구진이 확립한 수월성의 기준을 바탕으로, AAIL은 전통적인 제어공학의 엄밀함과 현대 컴퓨팅의 혁신적 역량을 융합해 나가고 있습니다.</p>
              <img src="images/legacy.jpg" alt="Legacy of FDCL" class="about-vision-img legacy-img" loading="lazy" />
              <div class="legacy-grid">
                <div class="legacy-card">
                  <span class="legacy-gen">1st Generation</span>
                  <h4 class="legacy-name">Prof. Sang-Kyu Wie</h4>
                  <p class="legacy-period">Dec 1955 – Feb 1991</p>
                  <ul class="legacy-edu">
                    <li>PhD, Seoul National University (1967)</li>
                    <li>MSc, University of Minnesota (1959)</li>
                    <li>BSc, Seoul National University (1950)</li>
                  </ul>
                </div>
                <div class="legacy-card">
                  <span class="legacy-gen">2nd Generation</span>
                  <h4 class="legacy-name">Prof. Youdan Kim</h4>
                  <p class="legacy-period">Feb 1992 – Aug 2025</p>
                  <ul class="legacy-edu">
                    <li>PhD, Texas A&amp;M University (1991)</li>
                    <li>MSc, Seoul National University (1985)</li>
                    <li>BSc, Seoul National University (1983)</li>
                  </ul>
                </div>
                <div class="legacy-card legacy-card-current">
                  <span class="legacy-gen">3rd Generation</span>
                  <h4 class="legacy-name">Prof. Namhoon Cho</h4>
                  <p class="legacy-period">Sep 2025 – Present</p>
                  <ul class="legacy-edu">
                    <li>PhD, Seoul National University (2017)</li>
                    <li>BSc, Seoul National University (2012)</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

        </div>
      </section>
    </div>

    <!-- RESEARCH ───────────────────────────────────────────── -->
    <div class="page" id="page-research">
      <section class="section">
        <div class="container container-narrow">
          <div class="section-header fade-in">
            <div class="section-num">02</div>
            <div class="section-header-text">
              <span class="section-kicker">Research</span>
              <h2 class="section-title">What We Work On</h2>
            </div>
            <div class="section-header-line"></div>
          </div>
          <div class="research-content fade-in">
            {{ collections.research[0].templateContent | safe }}
          </div>
        </div>
      </section>
    </div>

    <!-- PUBLICATIONS ───────────────────────────────────────── -->
    <div class="page" id="page-publications">
      <section class="section">
        <div class="container">
          <div class="section-header fade-in">
            <div class="section-num">04</div>
            <div class="section-header-text">
              <span class="section-kicker">Publications</span>
              <h2 class="section-title">Selected Works</h2>
            </div>
            <div class="section-header-line"></div>
          </div>

          <div class="pub-tabs fade-in">
            <button class="pub-tab active" data-filter="all">All</button>
            <button class="pub-tab" data-filter="journal">Journal</button>
            <button class="pub-tab" data-filter="conference">Conference</button>
            <button class="pub-tab" data-filter="preprint">Preprint</button>
          </div>

          <div class="pub-list" id="pub-list">
            {% for group in publicationsGrouped %}
            <div class="pub-year-group">
              <div class="pub-year-label">{{ group.year }}</div>
              {% for pub in group.items %}
              {{ macros.pubItem(pub) }}
              {% endfor %}
            </div>
            {% endfor %}
          </div>

        </div>
      </section>
    </div>

    <!-- SEMINAR ────────────────────────────────────────────── -->
    <div class="page" id="page-seminar">
      <section class="section">
        <div class="container container-narrow">
          <div class="section-header fade-in">
            <div class="section-num">05</div>
            <div class="section-header-text">
              <span class="section-kicker">Research</span>
              <h2 class="section-title">AAI Seminar</h2>
            </div>
            <div class="section-header-line"></div>
          </div>

          <div class="seminar-playlist fade-in">
            <iframe src="{{ seminars.playlistUrl }}" title="AAI Seminar Playlist" frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen loading="lazy"></iframe>
          </div>

          <div class="seminar-list">
            {% for group in seminars.years %}
            <div class="seminar-year-group fade-in">
              <h3 class="seminar-year-label">{{ group.year }}</h3>
              {% for talk in group.talks %}
              <div class="seminar-item">
                <div class="seminar-item-meta">
                  <span class="seminar-speaker">{{ talk.speaker }}</span>
                  <span class="seminar-affil">{{ talk.affiliation }}</span>
                  <span class="seminar-date">{{ talk.date }}</span>
                </div>
                <p class="seminar-title">
                  {% if talk.url %}
                  <a href="{{ talk.url }}" target="_blank" rel="noopener">{{ talk.title }} ↗</a>
                  {% else %}
                  {{ talk.title }}
                  {% endif %}
                </p>
              </div>
              {% endfor %}
            </div>
            {% endfor %}
          </div>

        </div>
      </section>
    </div>

    <!-- BOARD ──────────────────────────────────────────────── -->
    <div class="page" id="page-board">
      <section class="section">
        <div class="container">
          <div class="section-header fade-in">
            <div class="section-header-text">
              <span class="section-kicker">Board</span>
              <h2 class="section-title">Lab Board</h2>
            </div>
            <div class="section-header-line"></div>
          </div>

          <div class="pub-tabs fade-in" id="board-tabs">
            <button class="pub-tab active" data-panel="news">News</button>
            <button class="pub-tab" data-panel="gallery">Gallery</button>
          </div>

          <!-- Panel: News -->
          <div class="board-panel active" id="board-panel-news">
            <div id="news-container">
              {% set newsCount = collections.news | length %}
              <div class="board-list">
                <div class="board-list-header">
                  <span class="board-col-num">No.</span>
                  <span class="board-col-title">Title</span>
                  <span class="board-col-date">Date</span>
                </div>
                {% for item in collections.news %}
                <div class="board-row fade-in" onclick="openNewsModal({{ loop.index0 }})">
                  <span class="board-col-num">{{ newsCount - loop.index0 }}</span>
                  <span class="board-col-title">{{ item.data.title }}</span>
                  <span class="board-col-date">{{ item.data.year }}-{{ item.data.month | monthNum }}</span>
                </div>
                {% endfor %}
              </div>
            </div>
          </div>

          <!-- Panel: Gallery -->
          <div class="board-panel" id="board-panel-gallery">
            <div id="gallery-container">
              {% if collections.gallery | length == 0 %}
              <p style="color:var(--text-lt);font-size:.9rem;padding:24px 0;">No gallery posts yet.</p>
              {% else %}
              <div class="news-grid">
                {% for item in collections.gallery %}
                {% set dp = item.data.displayDate | splitFirst %}
                <div class="news-card gallery-card fade-in" role="button" tabindex="0"
                     onclick="openGalleryModal({{ loop.index0 }})"
                     onkeydown="if(event.key==='Enter')openGalleryModal({{ loop.index0 }})">
                  <div class="news-card-img">
                    {% if item.data.cover %}
                      <img src="{{ item.data.cover }}" alt="{{ item.data.title }}" loading="lazy" />
                    {% else %}
                      <div class="news-card-placeholder"><span>{{ dp[0] }}</span><span>{{ dp[1] }}</span></div>
                    {% endif %}
                  </div>
                  <div class="news-card-body">
                    <p class="news-card-date">{{ item.data.displayDate }}</p>
                    <p class="news-card-title">{{ item.data.title }}</p>
                  </div>
                </div>
                {% endfor %}
              </div>
              {% endif %}
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- CONTACT ────────────────────────────────────────────── -->
    <div class="page" id="page-contact">
      <section class="section">
        <div class="container">
          <div class="section-header fade-in">
            <div class="section-num">06</div>
            <div class="section-header-text">
              <span class="section-kicker">Contact</span>
              <h2 class="section-title">Find Us</h2>
            </div>
            <div class="section-header-line"></div>
          </div>

          <div class="contact-grid">
            <div class="contact-card fade-in">
              <div class="contact-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
              </div>
              <h3>Address</h3>
              <p>
                <span class="contact-address-label">Lab</span>
                Rm 318-2, Bldg 302<br />
                <span class="contact-address-label">PI Office</span>
                Rm 1309, Bldg 301<br />
                Department of Aerospace Engineering<br />Seoul National University<br />1 Gwanak-ro, Gwanak-gu<br />Seoul 08826, South Korea
              </p>
            </div>

            <div class="contact-card fade-in">
              <div class="contact-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 8.81 19.79 19.79 0 01.01 2.18 2 2 0 012 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
                </svg>
              </div>
              <h3>Phone</h3>
              <p>
                <span class="contact-address-label">Lab</span>
                (+82) 02-880-7392<br />
                <span class="contact-address-label">PI Office</span>
                (+82) 02-880-7398
              </p>
            </div>

            <div class="contact-card fade-in">
              <div class="contact-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M22.54 6.42a2.78 2.78 0 00-1.95-1.97C18.88 4 12 4 12 4s-6.88 0-8.59.45A2.78 2.78 0 001.46 6.42 29 29 0 001 12a29 29 0 00.46 5.58 2.78 2.78 0 001.95 1.97C5.12 20 12 20 12 20s6.88 0 8.59-.45a2.78 2.78 0 001.95-1.97A29 29 0 0023 12a29 29 0 00-.46-5.58z"/>
                  <polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/>
                </svg>
              </div>
              <h3>YouTube</h3>
              <p><a href="https://www.youtube.com/@SNU_AAIL" target="_blank" class="contact-link">@SNU_AAIL ↗</a></p>
            </div>
          </div>

          <div class="contact-bottom">
            <div class="contact-map fade-in">
              <iframe
                src="https://maps.google.com/maps?q=Seoul+National+University+1+Gwanak-ro+Gwanak-gu+Seoul+South+Korea&z=16&output=embed"
                width="100%" height="100%" style="border:0;"
                allowfullscreen="" loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
            <div class="join-cta fade-in">
              <h3>Interested in Joining?</h3>
              <p>We are looking for motivated graduate students and researchers. Please contact the PI with your CV and academic transcript.</p>
              <a href="mailto:namhoon.cho@snu.ac.kr" class="btn btn-outline">Email the PI ↗</a>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- PROJECTS ─────────────────────────────────────────────── -->
    <div class="page" id="page-projects">
      <section class="section">
        <div class="container">
          <div class="section-header fade-in">
            <div class="section-num">07</div>
            <div class="section-header-text">
              <span class="section-kicker">Research</span>
              <h2 class="section-title">Projects</h2>
            </div>
            <div class="section-header-line"></div>
          </div>

          <div class="proj-tabs-wrap fade-in">
            <button class="proj-tab active" data-filter="ongoing">Ongoing Projects</button>
            <button class="proj-tab" data-filter="completed">Completed Projects</button>
          </div>

          <div id="projects-container">
            <div id="projects-ongoing" class="proj-group">
              {{ macros.projCards(projects.ongoing, 'ongoing') }}
            </div>
            <div id="projects-completed" class="proj-group hidden">
              {{ macros.projCards(projects.completed, 'completed') }}
            </div>
          </div>
        </div>
      </section>
    </div>

  </main>

  <!-- ── FOOTER ──────────────────────────────────────────────── -->
  <footer class="footer">
    <div class="container">
      <div class="footer-inner">
        <div class="footer-brand">
          <a href="#" class="footer-logo nav-tab" data-target="page-home">
            <img src="images/aail-logo.png" alt="AAIL" />
          </a>
          <span class="nav-brand-divider"></span>
          <img src="images/snu.png" alt="Seoul National University" class="footer-snu-logo" />
        </div>
        <div class="footer-links">
          <a href="#" class="nav-tab" data-target="page-about">About</a>
          <a href="#" class="nav-tab" data-target="page-research">Research</a>
          <a href="#" class="nav-tab" data-target="page-publications">Publications</a>
          <a href="#" class="nav-tab" data-target="page-board">Board</a>
          <a href="#" class="nav-tab" data-target="page-contact">Contact</a>
        </div>
      </div>
      <div class="footer-copy">
        <p>Department of Aerospace Engineering, Seoul National University &nbsp;·&nbsp; Seoul, South Korea</p>
        <p class="footer-note">© Aerospace Autonomy and Intelligence Laboratory</p>
      </div>
    </div>
  </footer>

  <button class="go-top" id="go-top" aria-label="Back to top">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
      <polyline points="18 15 12 9 6 15"/>
    </svg>
  </button>

  <!-- Gallery / News Modal -->
  <div class="gallery-modal" id="gallery-modal" aria-hidden="true">
    <div class="gallery-modal-backdrop" id="gallery-modal-backdrop"></div>
    <div class="gallery-modal-dialog">
      <button class="gallery-modal-close" id="gallery-modal-close" aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
      <div class="gallery-modal-img-wrap" id="gallery-modal-img-wrap"></div>
      <div class="gallery-modal-info">
        <p class="gallery-modal-date" id="gallery-modal-date"></p>
        <h2 class="gallery-modal-title" id="gallery-modal-title"></h2>
        <p class="gallery-modal-text" id="gallery-modal-text"></p>
      </div>
    </div>
  </div>

  <!-- Inject data globals needed by script.js interaction logic -->
  <script>
  const NEWS           = {{ collections.news | newsJson | safe }};
  const GALLERY        = {{ collections.gallery | galleryJson | safe }};
  </script>
  <script src="script.js"></script>
</body>
</html>
