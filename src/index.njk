  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AAIL — Aerospace Autonomy and Intelligence Laboratory</title>

  <!-- SEO -->
  <meta name="description" content="The Aerospace Autonomy and Intelligence Laboratory (AAIL) at Seoul National University develops theory and algorithms for autonomous aerospace systems — guidance &amp; control, machine learning, and safe decision-making. Led by Prof. Namhoon Cho." />
