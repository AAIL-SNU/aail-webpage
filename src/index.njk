          </ul>
        </li>
        <li class="has-dropdown">
          <a href="#" class="nav-tab" data-target="page-board">Board</a>
          <ul class="nav-dropdown">
            <li><a href="#" class="board-subtab" data-subtab="news">News</a></li>
            <li><a href="#" class="board-subtab" data-subtab="gallery">Gallery</a></li>
