{% macro pageHeader(kicker, title) %}
<div class="section-header fade-in">
  <div class="section-header-text">
    <span class="section-kicker">{{ kicker }}</span>
    <h2 class="section-title">{{ title }}</h2>
  </div>
  <div class="section-header-line"></div>
</div>
{% endmacro %}

{% macro memberCard(mem, avatarKey, defaultRole) %}
<div class="member-card{% if mem.highlight %} member-card-highlight{% endif %}">
  <div class="member-photo-wrap">
    {% if mem.photo %}
    <img src="{{ ('/' ~ mem.photo) | url }}" alt="{{ mem.name }}" class="member-photo"
         onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
    {% endif %}
    <div class="member-avatar avatar-{{ avatarKey }}"{% if mem.photo %} style="display:none"{% endif %}>
      <svg viewBox="0 0 24 24" fill="currentColor" class="member-avatar-icon"><path d="M12 12c2.76 0 5-2.46 5-5.5S14.76 1 12 1 7 3.46 7 6.5 9.24 12 12 12Zm0 2.5c-3.87 0-9 2.13-9 5.5V23h18v-3c0-3.37-5.13-5.5-9-5.5Z"/></svg>
    </div>
  </div>
  <div class="member-info">
    <p class="member-name">{{ mem.name }}{% if mem.nameKr %}<span class="member-name-kr">{{ mem.nameKr }}</span>{% endif %}{% if mem.link %}<a class="member-link-icon" href="{{ mem.link }}" target="_blank" rel="noopener" aria-label="{{ mem.name }} website"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg></a>{% endif %}</p>
    <p class="member-role">{{ mem.role if mem.role else defaultRole }}{% if mem.badge %}<span class="member-badge">{{ mem.badge }}</span>{% endif %}</p>
    {% if mem.note %}<p class="member-note">{{ mem.note }}</p>{% endif %}
    {% if mem.email %}<a class="member-email" href="mailto:{{ mem.email }}">{{ mem.email }}</a>{% endif %}
    {% if mem.researchInterest %}<p class="member-research"><span class="member-research-label">Research Topic:</span> {{ mem.researchInterest }}</p>{% endif %}
    {% if mem.interests and mem.interests.length > 0 %}
    <div class="member-interests">
      {% for tag in mem.interests %}<span class="member-interest-tag">{{ tag }}</span>{% endfor %}
    </div>
    {% endif %}
  </div>
</div>
{% endmacro %}

{% macro pubItem(pub) %}
<div class="pub-item fade-in" data-type="{{ pub.type }}">
  <div class="pub-badge {{ pub.type }}">
    {%- if pub.type == 'journal' %}Journal
    {%- elif pub.type == 'conference' %}Conference
    {%- else %}Preprint{% endif -%}
  </div>
  <div class="pub-content">
    <a href="{{ pub.computedUrl }}" target="_blank" rel="noopener" class="pub-title">{{ pub.title }}</a>
    <p class="pub-authors">{{ pub.authors }}</p>
    <p class="pub-venue">{{ pub.venue | safe }}</p>
  </div>
</div>
{% endmacro %}

{% macro courseCard(c) %}
<div class="course-card">
  {% if c.level %}<span class="course-level">{{ c.level }}</span>{% endif %}
  <h4 class="course-name">{{ c.name }}</h4>
  {% if c.code %}<p class="course-code">{{ c.code }}</p>{% endif %}
  <p class="course-period">{{ c.period }}</p>
  {% if c.role %}<span class="course-role">{{ c.role }}</span>{% endif %}
</div>
{% endmacro %}

{% macro projCards(list, filter) %}
{% if list | length == 0 %}
<p class="proj-empty fade-in">No {{ filter }} projects at this time.</p>
{% else %}
{% for p in list %}
<div class="proj-card fade-in" style="animation-delay:{{ loop.index0 * 60 }}ms">
  <div class="proj-card-num">{{ loop.index | padNum }}</div>
  <div class="proj-card-body">
    <h3 class="proj-card-title">{{ p.title }}</h3>
    <dl class="proj-meta">
      <dt>Period</dt><dd>{{ p.period }}</dd>
      <dt>Funding Agency</dt><dd>{{ p.agency }}</dd>
      {% if p.program %}<dt>Program</dt><dd>{{ p.program }}</dd>{% endif %}
      {% if p.institution %}<dt>Institution</dt><dd>{{ p.institution }}</dd>{% endif %}
      {% if p.note %}<dt>Note</dt><dd>{{ p.note }}</dd>{% endif %}
    </dl>
  </div>
</div>
{% endfor %}
{% endif %}
{% endmacro %}
