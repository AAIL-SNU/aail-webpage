{% macro pageHeader(kicker, title) %}
<div class="section-header fade-in">
  <div class="section-header-text">
    <span class="section-kicker">{{ kicker }}</span>
    <h2 class="section-title">{{ title }}</h2>
  </div>
  <div class="section-header-line"></div>
</div>
{% endmacro %}

